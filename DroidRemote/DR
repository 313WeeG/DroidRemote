
DB_FILE = os.path.expanduser("~/known_devices.json")
RED, BLACK, RESET, BOLD, GREEN, YELLOW = "\033[1;31m", "\033[1;30m", "\033[0m", "\033[1m", "\033[1;32m", "\033[1;33m"

