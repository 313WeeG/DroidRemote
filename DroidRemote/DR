def load_known_devices():
    if os.path.exists(DB_FILE):
        try:
            with open(DB_FILE, "r") as f: return json.load(f)
        except: return {}
    return {}

def save_device(serial, name, ip):
    devices = load_known_devices()
    devices[serial] = {"name": name, "last_known_ip": ip, "saved_at": time.time()}
    with open(DB_FILE, "w") as f: json.dump(devices, f, indent=4)
    print(f"{GREEN}[+] Saved device profile: {name} [{serial}]{RESET}")

class NetworkDiscoveryListener:
    def __init__(self):
        self.found_pairings, self.found_connections = [], []
    def remove_service(self, zc, type, name): pass
    def update_service(self, zc, type, name): pass
    def add_service(self, zc, type, name):
        info = zc.get_service_info(type, name)
        if info and info.addresses:
            raw = info.addresses[0] if isinstance(info.addresses, list) else info.addresses
            ip = socket.inet_ntoa(raw)
            if "_adb-tls-pairing" in type: self.found_pairings.append((ip, info.port))
            elif "_adb-tls-connect" in type: self.found_connections.append((ip, info.port))

def manual_pairing_fallback():
    print(f"\n{YELLOW}[*] Switching to Manual 6-Digit Pairing Mode...{RESET}")
    ip_port = input(f"{BOLD}Enter target IP:Port shown on phone: {RESET}").strip()
    pair_code = input(f"{BOLD}Enter the 6-Digit Pairing Code: {RESET}").strip()
    if ip_port and pair_code:
        os.system(f"adb pair {ip_port} {pair_code}")
        time.sleep(2)
        target_ip = ip_port.split(":")[0]
        connect_port = input(f"{BOLD}Enter active connection port (from main screen): {RESET}").strip()
        conn_str = f"{target_ip}:{connect_port}"
        subprocess.run(["adb", "connect", conn_str])
        time.sleep(1)
        r = subprocess.run(["adb", "devices"], capture_output=True, text=True)
        if "device" in r.stdout:
            m = subprocess.run(["adb", "shell", "getprop", "ro.product.model"], capture_output=True, text=True)
            model = m.stdout.strip() if m.returncode == 0 else "Tailscale Target"
            save_device(conn_str, model, target_ip)
            print(f"{GREEN}[+] Framework Linked over network to target device!{RESET}")

def main():
    print_banner()
    known_devices = load_known_devices()
    zeroconf = Zeroconf()
    listener = NetworkDiscoveryListener()
    bp = ServiceBrowser(zeroconf, "_adb-tls-pairing._tcp.local.", listener)
    bc = ServiceBrowser(zeroconf, "_adb-tls-connect._tcp.local.", listener)
    print(f"{YELLOW}[*] Scanning network for active Droid-Remote endpoints...{RESET}")
    time.sleep(2)

    if listener.found_connections:
        online_matches = []
        for ip, port in listener.found_connections:
            target_addr = f"{ip}:{port}"
            subprocess.run(["adb", "connect", target_addr], capture_output=True, text=True)
            time.sleep(0.5)
            r = subprocess.run(["adb", "devices"], capture_output=True, text=True)
            if "device" in r.stdout:
                name = known_devices.get(target_addr, {}).get("name", f"Tailscale Target ({ip})")
                online_matches.append({"serial_addr": target_addr, "name": name})
        if online_matches:
            print(f"\n{GREEN}[+] Multiple active devices detected!{RESET}")
            for idx, dev in enumerate(online_matches, 1):
                print(f" [{idx}] {BOLD}{dev['name']}{RESET} | ID: {dev['serial_addr']}")
            print(" [M] Pair a new target device manually via 6-digit Code")
            print(" [Q] Scan a new device via QR Code Setup")
            choice = input(f"{BOLD}Select action: {RESET}").strip().lower()
            if choice == 'm':
                zeroconf.close(); manual_pairing_fallback(); return
            elif choice.isdigit() and 1 <= int(choice) <= len(online_matches):
                selected = online_matches[int(choice) - 1]
                zeroconf.close()
                print(f"{GREEN}[+] Target Connected: {selected['name']}{RESET}")
                return

    print(f"\n{YELLOW}[*] Launching QR Engine...{RESET}")
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try: s.connect(("8.8.8.8", 80)); pc_ip = s.getsockname()[0]
    except: pc_ip = "127.0.0.1"
    finally: s.close()
    
    subprocess.run(["adb", "kill-server"], stdout=subprocess.DEVNULL)
    subprocess.run(["adb", "start-server"], stdout=subprocess.DEVNULL)
    payload = f"WIFI:T:ADB;S:{pc_ip}:5555;P:DR123;;"
    print(f"\n{RED}[!] Scan matrix below or press Ctrl+C to switch to Manual Mode:{RESET}\n")
    qr = qrcode.QRCode(version=1, box_size=1, border=1)
    qr.add_data(payload); qr.make(fit=True); qr.print_ascii(invert=True)

    try:
        start_wait = time.time()
        while not listener.found_pairings:
            if time.time() - start_wait > 15: break
            time.sleep(1)
        if listener.found_pairings:
            t_ip, t_port = listener.found_pairings[0]
            zeroconf.close()
            os.system(f"adb pair {t_ip}:{t_port} DR123")
            time.sleep(2)
            zc_recon = Zeroconf(); list_recon = NetworkDiscoveryListener()
            br_recon = ServiceBrowser(zc_recon, "_adb-tls-connect._tcp.local.", list_recon)
            time.sleep(3); zc_recon.close()
            if list_recon.found_connections:
                c_ip, c_port = list_recon.found_connections[0]
                conn_str = f"{c_ip}:{c_port}"
                subprocess.run(["adb", "connect", conn_str], stdout=subprocess.DEVNULL)
                time.sleep(1)
                m = subprocess.run(["adb", "shell", "getprop", "ro.product.model"], capture_output=True, text=True)
                model = m.stdout.strip() if m.returncode == 0 else "Android Device"
                save_device(conn_str, model, c_ip)
                print(f"{GREEN}[+] Setup complete. Control terminal ready!{RESET}")
            else: manual_pairing_fallback()
        else: zeroconf.close(); manual_pairing_fallback()
    except KeyboardInterrupt: zeroconf.close(); manual_pairing_fallback()

if __name__ == "__main__":
    main()
